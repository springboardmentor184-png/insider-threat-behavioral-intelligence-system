# Insider Threat Behavioral Intelligence System - Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual credentials

# Security Configurations
SECRET_KEY=your_secure_random_secret_key_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (SQLite by default, or PostgreSQL for Production)
DATABASE_URL=sqlite:///./insider_threat.db

# Real SMTP Email Configuration (Google Gmail / Office365)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
ADMIN_EMAIL=admin@company.com
