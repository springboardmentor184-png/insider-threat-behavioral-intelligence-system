# Flask configuration
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=super-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# Database configuration (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=insider_threat_db
MYSQL_USER=root
MYSQL_PASSWORD=yourpassword

# Optional: Set to False to disable SQLite fallback if MySQL connection fails
SQLITE_FALLBACK=True

# Critical-threat administrator email notifications
SMTP_ENABLED=False
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=security-alerts@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=security-alerts@example.com
SMTP_USE_TLS=True
# Optional extra recipients. Linked ADMIN/ADMINISTRATOR accounts are included automatically.
ADMIN_ALERT_EMAILS=security-admin@example.com
